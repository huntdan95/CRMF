rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public assets (site photos, blog post photos): anyone can fetch a
    // file whose address they have, only admins can upload/delete. Not
    // list: a listing would turn up blog drafts' photos Travis hasn't
    // approved, and the paths of posts he took down. The site never lists
    // from the browser (the server's Admin SDK isn't bound by these
    // rules), but an admin still can. Same list as isAdmin() in
    // firestore.rules.
    match /public/{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Trip photos and videos the crew upload from /upload/<token>, with no
    // login. An upload must carry the departure's upload token in its
    // custom metadata, the token must belong to this trip, and the link
    // must not have expired (7 days after the trip). Files can only be
    // added, never overwritten, and only photos and videos: the type and
    // the name's extension both say so (the uploader names each file for
    // its type). No backslashes either: the name is what guests save the
    // file as, in "Download all" too, where one would read as a folder.
    //
    // Guests never read these directly: the website shows them through
    // download-token URLs and its own download routes. Admin deletes go
    // through the adminDeleteTripPhoto Cloud Function.
    //
    // firestore.get() here needs Storage's permission to read Firestore;
    // `firebase deploy --only storage` asks to grant it the first time.
    match /trips/{tripId}/{fileName} {
      allow read: if isAdmin();
      allow create: if request.resource.size < 5 * 1024 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'))
        && fileName.matches('[^\\\\]+[.](?i:jpe?g|png|heic|heif|gpr|dng|webp|gif|avif|mp4|mov|m4v|3gp|webm)')
        && validUploadToken(tripId, request.resource.metadata.uploadToken);
      allow update, delete: if false;
    }

    // Signed waiver PDFs and signature images: server-only (Admin SDK).
    // Admin views them through /admin/waivers/{id}/pdf; no client, signed
    // in or not, can read, replace, or delete them.
    match /waivers/{allPaths=**} {
      allow read, write: if false;
    }

    function validUploadToken(tripId, token) {
      let path = /databases/(default)/documents/tripUploadTokens/$(token);
      return token is string
        && token.size() > 20
        && firestore.exists(path)
        && firestore.get(path).data.tripId == tripId
        && request.time < firestore.get(path).data.expiresAt;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['travisurbin1@gmail.com', 'hunt.db.95@gmail.com']
        && request.auth.token.email_verified == true;
    }
  }
}
