rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Tours: public read, admin write only.
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Seasonal / holiday rates: the website reads them server-side, so only
    // the admin reads them from the browser (unannounced rates stay private).
    // Writes only via Cloud Functions (adminUpsertRateSeason).
    match /rateSeasons/{seasonId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Bookings: never directly readable from the client.
    // - Customers fetch their booking through a Cloud Function that validates accessToken.
    // - Admin reads via the authenticated admin app.
    // - All writes go through Cloud Functions (transactional, capacity-checked).
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Blackouts: public read (so the booking UI can render availability),
    // admin write only.
    match /blackouts/{blackoutId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (cancellation policy text, email templates): public read,
    // admin write.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Closing a day (functions/src/lib/close-day.ts). Previews hold the
    // hash of a confirm token: server-only. Actions record who closed which
    // day, the undo window and what was sent: admin read, so the dashboard
    // banner can count down; written only by Cloud Functions.
    match /closurePreviews/{previewId} {
      allow read, write: if false;
    }
    match /closureActions/{blackoutId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit log: admin-only read, writes only via Cloud Functions.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reschedule requests (customer-initiated, processed manually by Travis
    // in v1): admin-only read, writes only via Cloud Functions.
    match /rescheduleRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Stripe webhook event log (idempotency dedupe): functions-only.
    match /stripeWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Every email the site sends, and what Resend reported about it
    // (functions/src/lib/email-log.ts, resendWebhook): admin-only read,
    // writes only via Cloud Functions.
    match /emailLog/{emailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Resend webhook deliveries (dedupe on svix-id): functions-only.
    match /resendWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Site images (admin-uploaded photos for marketing pages): public read
    // so marketing pages render them, admin writes go through Cloud Functions.
    match /siteImages/{slot} {
      allow read: if true;
      allow write: if false;
    }

    // Testimonials (admin-curated guest reviews): public read because
    // marketing pages render them; admin writes go through Cloud Functions.
    // NOTE: components are responsible for filtering on `published == true`.
    // Reading unpublished drafts is harmless — they're customer reviews, not
    // sensitive data — but the rendering layer hides them.
    match /testimonials/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Signed liability waivers. Written once by the Next app's signing
    // route (Admin SDK) and never edited or deleted from a client — they're
    // legal records. Admin reads; guests get their copy by email.
    match /waivers/{waiverId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The exact waiver wording behind each signed record's documentSha256,
    // keyed by that hash. Written once by the signing route; never edited.
    match /waiverTexts/{sha} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contact form messages: write via server action; admin reads.
    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Crew (swim guides / mates who sign in at /crew). Managed through
    // admin Cloud Functions; crew sign-in and their schedule run in the
    // Next app with the Admin SDK, so crew never read Firestore directly.
    match /crew/{crewId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Phones with booking notifications on: admin reads them to show who
    // has notifications on; the Next app writes them.
    match /crewPushSubscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Password hashes, signed-in sessions, and test-notification requests:
    // server-only.
    match /crewCredentials/{crewId} {
      allow read, write: if false;
    }
    match /crewSessions/{sessionId} {
      allow read, write: if false;
    }
    match /crewPushTests/{testId} {
      allow read, write: if false;
    }

    // Devices Travis (or another admin) turned admin notifications on for,
    // and the "Send a test" requests. Server-only: the Next app writes them,
    // functions/src/adminNotifications.ts reads them.
    match /adminPushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }
    match /adminPushTests/{testId} {
      allow read, write: if false;
    }

    // Trips Travis runs without crew, `YYYY-MM-DD_<timeSlot>`. Admin reads
    // them to show each trip's crew switch; adminSetTripCrew writes them.
    match /soloTrips/{tripId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Crew calendar feeds (/api/crew-calendar/[token]): the hash of each
    // live link, which link each crew member has, and each departure's
    // event fingerprint + SEQUENCE. The link is the only key to the feed,
    // so nobody reads these from a browser, admin included. Server-only
    // (Cloud Functions and the Next app with the Admin SDK).
    match /crewCalendarTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /crewCalendars/{crewId} {
      allow read, write: if false;
    }
    match /crewCalendarDepartures/{departureId} {
      allow read, write: if false;
    }

    // Trip photos (one doc per departure, `YYYY-MM-DD_<slot>`): the crew's
    // upload token, photo count, last upload, Drive folder; and one doc per
    // uploaded file. Written by Cloud Functions and the website's server.
    match /tripPhotos/{tripId} {
      allow read: if isAdmin();
      allow write: if false;

      match /files/{fileId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Upload tokens → trip, checked by storage.rules (which reads them as
    // the Storage service, not through these rules). Server-only.
    match /tripUploadTokens/{token} {
      allow read, write: if false;
    }

    // Travis's Google Drive connection (refresh token) and the "CRMF
    // Trips" folder id. Server-only.
    match /driveConfig/{docId} {
      allow read, write: if false;
    }

    // Blog posts grokbot submits through the MCP endpoint. The site reads
    // and writes them with the Admin SDK (the News pages, Admin → Blog, the
    // review page).
    match /newsPosts/{slug} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One doc per evening's "tomorrow's trips" crew email: when it went
    // out, so it's never sent twice. Written by Cloud Functions.
    match /crewSchedules/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Review emails waiting to go to Travis (with the review link's token):
    // the site writes them, onBlogReviewRequested sends and deletes them.
    match /blogReviewRequests/{slug} {
      allow read, write: if false;
    }

    // The 6 PM review-request list Travis gets: when it went out.
    match /reviewLists/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // "Tell Travis privately" messages from the thank-you email. Saved by
    // the submitFeedback Cloud Function; Travis reads them.
    match /guestFeedback/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function isAdmin() {
      // Travis (ADMIN_EMAIL), then OTHER_ADMIN_EMAILS from apphosting.yaml
      // and functions/.env.crmf-99aad. Keep all of them and storage.rules
      // in step.
      // email_verified, as requireAdmin() in the Cloud Functions and the
      // admin session check do: an unverified account can't claim the address.
      return request.auth != null &&
        request.auth.token.email in ['travisurbin1@gmail.com', 'hunt.db.95@gmail.com'] &&
        request.auth.token.email_verified == true;
    }
  }
}
