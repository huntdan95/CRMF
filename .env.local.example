# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
#
# In production these are managed via Firebase App Hosting secrets
# (see apphosting.yaml). For local dev you populate them here.

# ---------------------------------------------------------------------------
# Firebase web SDK config (public — shipped to the browser).
# Get these from: Firebase console → Project settings → Your apps → Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Firebase Analytics when set
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Admin allowlist — the email Travis logs in with at /admin.
# Used by middleware and Firestore security rules.
NEXT_PUBLIC_ADMIN_EMAIL=
# More accounts allowed into /admin, comma-separated (optional).
OTHER_ADMIN_EMAILS=

# Public VAPID key for crew push notifications (/crew). Same value as in
# apphosting.yaml; must match VAPID_PUBLIC_KEY in functions/src/lib/crew-push.ts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Base URL for the deployed Cloud Functions. The client booking flow calls
# `${this}/createCheckoutSession`, `${this}/getAvailability`, etc.
# Production:  https://us-central1-<project>.cloudfunctions.net
# Emulator:    http://127.0.0.1:5001/<project>/us-central1
NEXT_PUBLIC_FUNCTIONS_BASE_URL=

# Shared secret for the MCP endpoint (/api/mcp), at least 32 characters.
# Must equal the MCP_TOKEN Cloud Functions secret, or the edit tools are
# refused. Leave blank to keep /api/mcp switched off locally.
MCP_TOKEN=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only).
# Create a service account in: Firebase console → Project settings →
# Service accounts → Generate new private key. The JSON file gives you these.
# In Firebase App Hosting / Cloud Run, leave these blank — Application
# Default Credentials are used automatically.
# Note: keep \n escapes in FIREBASE_ADMIN_PRIVATE_KEY when pasting from the
# JSON — admin.ts converts them back to real newlines.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Stripe and Resend keys don't go here: the site reads none of them. The
# Cloud Functions do, and the functions emulator takes them (with
# APP_BASE_URL, MCP_TOKEN and VAPID_PRIVATE_KEY) from functions/.secret.local,
# gitignored. A secret missing there is read from the project's Secret
# Manager, which on the real project means production's keys: put
# STRIPE_SECRET_KEY=sk_test_… and the rest in. README → Local development, 5.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Google Drive for trip photos (server-only; README → Crew app setup).
# GOOGLE_DRIVE_CLIENT_ID/_SECRET are the "Desktop app" OAuth client that
# `npm run connect:drive` signs in with, and GOOGLE_DRIVE_REFRESH_TOKEN is
# the token it prints. All three, or the site skips the Drive copy.
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: the "Connect Google Drive" button in Admin → Settings needs its
# own "Web application" client, with
# http://localhost:3000/api/admin/google-drive/callback as a redirect URI.
# Without it Settings shows only the connect:drive steps.
GOOGLE_DRIVE_WEB_CLIENT_ID=
GOOGLE_DRIVE_WEB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Local testing against the Firebase emulators only. Leave blank otherwise.
# ---------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
